<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.twinbox.vm"
    android:versionCode="308"
    android:versionName="1.2.158">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="27" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v1.2.51：日志写公共 Documents/TwinVM（targetSdk=27 旧存储模型，
         运行时授权；拒授自动回退 App 私有目录） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- v1.2.69：防 freezer（运行期持 PARTIAL_WAKE_LOCK） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- v1.2.70：运行期前台服务（freezer 豁免） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
        <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false">

        <service android:name=".RunService" android:exported="false"
            android:stopWithTask="true" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
